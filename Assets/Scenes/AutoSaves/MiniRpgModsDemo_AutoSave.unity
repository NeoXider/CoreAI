  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1944e5601b054674f9aba21055a2342c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: CoreAI.Demos::CoreAI.Demos.ChatPromptButtonsController
  title: "Mini-RPG mod tasks (easy \u2192 hard)"
  panelRect:
    serializedVersion: 2
    x: 12
    y: 412
    width: 560
    height: 180
  chatReserveWidth: 700
  prompts:
  - Label: 'Easy: torch flicker (light)'
    Prompt: Create and load a persistent Lua mod named 'torch_flicker' that every
      0.4 seconds sets the scene's directional light intensity to a slightly random
      value between 0.7 and 1.3 so the world looks lit by flickering torches. Use
      hooks_every.
  - Label: 'Medium: day/night cycle'
    Prompt: Create and load a persistent Lua mod named 'day_night' that every 10
      seconds advances a phase dawn -> day -> dusk -> night, rotates the directional
      light to match, emits a 'phase_changed' event with the phase name, logs it
      via report(), and persists the phase index with store_set so it survives a
      reload.
  - Label: 'Hard: village quest (inter-mod)'
    Prompt: 'Create two cooperating Lua mods for a village-defense quest. Mod ''spawner'':
      every 5 seconds spawn a wandering enemy cube near the player and publish the
      live enemy count via mods_export(''count'', n). Mod ''quest'': every 5 seconds
      read the count with mods_get(''spawner'',''count''); when it reaches 3 or more,
      emit a ''quest_complete'' event and report(''Village defended!''). Load both.'
  submitWhenInputUnavailable: 0
  _showPanel: 1
  _toggleKey: 289
