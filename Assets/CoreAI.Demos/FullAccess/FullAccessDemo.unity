  m_Name: 
  m_EditorClassIdentifier: CoreAI.Demos::CoreAI.Demos.ChatPromptButtonsController
  title: Full Access mod prompts
  panelRect:
    serializedVersion: 2
    x: 12
    y: 412
    width: 560
    height: 180
  chatReserveWidth: 400
  prompts:
  - Label: Make cube float
    Prompt: Make the cube float above the arena and keep it there as a small saved
      mod. Tell me briefly what changed.
  - Label: Make cube bigger
    Prompt: Make the cube noticeably bigger, but keep it in the same place. Save
      it as a reusable mod and tell me briefly what changed.
  - Label: Inspect cube
    Prompt: Check the cube in the scene and tell me its current position, scale,
      and important components. Do not change it.
  submitWhenInputUnavailable: 0
