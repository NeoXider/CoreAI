<linker>
  <!-- WebGL/IL2CPP: keep MoonSharp Lua marshalling/reflection metadata when Lua-on-WebGL is enabled -->
  <assembly fullname="MoonSharp.Interpreter" preserve="all"/>
  <!-- Microsoft.Extensions.AI core -->
  <assembly fullname="Microsoft.Extensions.AI" preserve="all"/>
  <assembly fullname="Microsoft.Extensions.AI.Abstractions" preserve="all"/>

  <!-- Зависимости, критичные для работы MEAI -->
  <assembly fullname="Microsoft.Extensions.DependencyInjection.Abstractions" preserve="all"/>
  <assembly fullname="Microsoft.Extensions.Logging.Abstractions" preserve="all"/>
  <assembly fullname="System.Text.Json" preserve="all"/>
  <assembly fullname="System.Threading.Channels" preserve="all"/>
  
  <!-- Сохраняем наши скрипты, чтобы рефлексия MEAI работала с MemoryTool -->
  <assembly fullname="CoreAI.Core" preserve="all"/>

  <!-- Unity/WebGL: VContainer + DI цепочка к MessagePipe (см. CoreServicesInstaller / MessagePipeAiCommandSink) -->
  <assembly fullname="CoreAI.Source">
    <type fullname="CoreAI.Infrastructure.Messaging.MessagePipeAiCommandSink" preserve="all"/>

    <!-- WebGL/IL2CPP: Lua game bindings register host callbacks as plain delegates; MoonSharp invokes
         them via reflection (InteropAccessMode.Reflection on AOT), so the managed-stripper never sees a
         direct call and may drop the lambda bodies. Preserve the binding types that run on the WebGL
         player (every tier except Full) so their reflection-invoked methods survive. -->
    <!-- Full-tier reflection bindings are used on WebGL when the host enables Full Lua (e.g. the
         FullAccessDemo scene); preserved defensively. NOTE: this preserve alone does NOT fix the
         known WebGL crash - any unity_* call from Lua still traps with "RuntimeError: null function"
         (byte-identical wasm with/without this entry, so nothing was stripped; the fault is in the
         IL2CPP/MoonSharp delegate-interop path and needs a development-build diagnosis). -->
    <type fullname="CoreAI.Infrastructure.Lua.CoreAiFullUnityLuaRuntimeBindings" preserve="all"/>
    <type fullname="CoreAI.Infrastructure.World.CoreAiWorldLuaRuntimeBindings" preserve="all"/>
    <type fullname="CoreAI.Infrastructure.World.CoreAiWorldQueryLuaBindings" preserve="all"/>
    <type fullname="CoreAI.Infrastructure.Lua.CoreAiVersioningLuaRuntimeBindings" preserve="all"/>
    <type fullname="CoreAI.Infrastructure.Lua.LoggingLuaRuntimeBindings" preserve="all"/>
    <type fullname="CoreAI.Infrastructure.Lua.LuaTimeBindings" preserve="all"/>
    <type fullname="CoreAI.Infrastructure.Lua.AggregatingGameLuaRuntimeBindings" preserve="all"/>
  </assembly>
</linker>