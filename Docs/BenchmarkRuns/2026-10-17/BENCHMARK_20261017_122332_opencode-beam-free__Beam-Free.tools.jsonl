{"scenarioId":"g7_extreme_dungeon","name":"execute_lua","status":"completed","arguments":"{\"code\":\"local letters={'A','B','C','D','E','F','G','H','I'}\\nlocal function room_exists_name(n) return type(n)=='string' and string.match(n,'^Room_[A-I]$')~=nil and coreai_world_exists(n) end\\nlocal function room_list() local o={} for _,L in ipairs(letters) do local n='Room_'..L if coreai_world_exists(n) then table.insert(o,n) end end return o end\\nlocal function room_of_func(name)\\n  if type(name)~='string' or not coreai_world_exists(name) then return 'none' end\\n  local p=coreai_world_pos(name)\\n  if not p then return 'none' end\\n  local rooms=room_list()\\n  if #rooms==0 then return 'none' end\\n  local minDist=nil\\n  for _,r in ipairs(rooms) do local rp=coreai_world_pos(r) if rp then local d=math.sqrt((p.x-rp.x)^2+(p.z-rp.z)^2) if minDist==nil or d<minDist then minDist=d end end end\\n  if minDist==nil then return 'none' end\\n  local thr=minDist*1.01\\n  for _,L in ipairs(letters) do local rn='Room_'..L if coreai_world_exists(rn) then local rp=coreai_world_pos(rn) if rp then local d=math.sqrt((p.x-rp.x)^2+(p.z-rp.z)^2) if d<=thr then return rn end end end end\\n  return 'none'\\nend\\nlocal function parse_door(name)\\n  if type(name)~='string' then return nil end\\n  local p,q,col=string.match(name,'^Door_([A-I])_([A-I])_(Red)$')\\n  if not p then p,q,col=string.match(name,'^Door_([A-I])_([A-I])_(Blue)$') end\\n  if not p then p,q,col=string.match(name,'^Door_([A-I])_([A-I])_(Gold)$') end\\n  if not p then p,q=string.match(name,'^Door_([A-I])_([A-I])$') col=nil end\\n  if not p or p==q then return nil end\\n  return p,q,col\\nend\\nlocal function has_colour(inv,c) if type(inv)~='string' then inv=tostring(inv or '') end for x in string.gmatch(inv,'[^,]+') do if x==c then return true end end return false end\\nlocal function collect_doors() local o={} local names=coreai_world_find('Door_') for _,nm in ipairs(names) do local p,q,col=parse_door(nm) if p then table.insert(o,{name=nm,p=p,q=q,colour=col}) end end return o end\\nlocal function build_adjacency(inv) local adj={} local rooms=room_list() for _,r in ipairs(rooms) do adj[r]={} end for _,d in ipairs(collect_doors()) do local r1='Room_'..d.p local r2='Room_'..d.q if room_exists_name(r1) and room_exists_name(r2) then local openable=(d.colour==nil) or has_colour(inv,d.colour) or has_colour(inv,'Gold') if openable then table.insert(adj[r1],r2) table.insert(adj[r2],r1) end end end return adj end\\nlocal function bfs_distances(source,inv) if not room_exists_name(source) then return nil end local adj=build_adjacency(inv) local dist={[source]=0} local q={source} local h=1 while h<=#q do local cur=q[h] h=h+1 for _,nb in ipairs(adj[cur] or {}) do if dist[nb]==nil then dist[nb]=dist[cur]+1 table.insert(q,nb) end end end return dist end\\nlocal function pickup_inventory(room,inv) local set={} for c in string.gmatch(inv or '', '[^,]+') do set[c]=true end for _,col in ipairs({'Blue','Gold','Red'}) do local keyName='Key_'..col if coreai_world_exists(keyName) and room_of_func(keyName)==room then set[col]=true end end local out={} for c,_ in pairs(set) do table.insert(out,c) end table.sort(out) return table.concat(out,',') end\\nlogic_define('room_of', room_of_func)\\nlogic_define('can_open', function(door, inventory) if type(door)~='string' then return false end if not coreai_world_exists(door) then return false end local p,q,col=parse_door(door) if not p then return false end local inv=(inventory==nil) and '' or tostring(inventory) if col==nil then return true end if has_colour(inv,col) then return true end if has_colour(inv,'Gold') then return true end return false end)\\nlogic_define('reachable', function(fromRoom, toRoom, inventory) if type(fromRoom)~='string' or type(toRoom)~='string' then return false end if not room_exists_name(fromRoom) or not room_exists_name(toRoom) then return false end if fromRoom==toRoom then return true end local inv=(inventory==nil) and '' or tostring(inventory) local dists=bfs_distances(fromRoom, inv) if not dists then return false end return dists[toRoom]~=nil end)\\nlogic_define('next_step', function(fromRoom, toRoom, inventory) if type(fromRoom)~='string' or type(toRoom)~='string' then return 'none' end if not room_exists_name(fromRoom) or not room_exists_name(toRoom) then return 'none' end if fromRoom==toRoom then return fromRoom end local inv=(inventory==nil) and '' or tostring(inventory) local dists=bfs_distances(toRoom, inv) if not dists or dists[fromRoom]==nil then return 'none' end local total=dists[fromRoom] if total<=0 then return fromRoom end local adj=build_adjacency(inv) local cand={} for _,nb in ipairs(adj[fromRoom] or {}) do if dists[nb]==total-1 then table.insert(cand,nb) end end if #cand==0 then return 'none' end table.sort(cand) return cand[1] end)\\nlogic_define('min_doors_to_exit', function(inventory) if not coreai_world_exists('Player') or not coreai_world_exists('Exit') then return -1 end local startRoom=room_of_func('Player') local exitRoom=room_of_func('Exit') if startRoom=='none' or exitRoom=='none' then return -1 end local inv0=(inventory==nil) and '' or tostring(inventory) local startInv=pickup_inventory(startRoom, inv0) if startRoom==exitRoom then return 0 end local validDoors={} for _,d in ipairs(collect_doors()) do local r1='Room_'..d.p local r2='Room_'..d.q if room_exists_name(r1) and room_exists_name(r2) then table.insert(validDoors,{r1=r1,r2=r2,colour=d.colour}) end end local visited={} local key0=startRoom..'|'..startInv visited[key0]=true local q={{room=startRoom,inv=startInv,dist=0}} local h=1 while h<=#q do local st=q[h] h=h+1 for _,d in ipairs(validDoors) do local other=nil if d.r1==st.room then other=d.r2 elseif d.r2==st.room then other=d.r1 end if other then local openable=(d.colour==nil) or has_colour(st.inv,d.colour) or has_colour(st.inv,'Gold') if openable then local newInv=pickup_inventory(other,st.inv) local key=other..'|'..newInv if not visited[key] then if other==exitRoom then return st.dist+1 end visited[key]=true table.insert(q,{room=other,inv=newInv,dist=st.dist+1}) end end end end end return -1 end)\"}","result":"{\"Success\":true,\"Output\":\"ok\"}","error":"","durationMs":5.4429}
