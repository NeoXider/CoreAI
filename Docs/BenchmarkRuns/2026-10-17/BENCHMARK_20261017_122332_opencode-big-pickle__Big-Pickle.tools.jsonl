{"scenarioId":"g4_combat","name":"execute_lua","status":"completed","arguments":"{\"code\":\"logic_define('attack_damage', function(attacker_power, defender_armor)\\n  local dmg = attacker_power - defender_armor\\n  if dmg < 1 then dmg = 1 end\\n  return dmg\\nend)\\nlogic_define('apply_damage', function(hp, damage)\\n  local new_hp = hp - damage\\n  if new_hp < 0 then new_hp = 0 end\\n  return new_hp\\nend)\\nlogic_define('is_dead', function(hp)\\n  return hp <= 0\\nend)\\nreport('Defined logic slots: attack_damage, apply_damage, is_dead')\"}","result":"{\"Success\":true,\"Output\":\"ok\"}","error":"","durationMs":2.3373}
{"scenarioId":"g4_crafting_chain","name":"execute_lua","status":"completed","arguments":"{\"code\":\"local function pair(a, b)\\n  local x, y = tostring(a), tostring(b)\\n  if x > y then x, y = y, x end\\n  return x .. \\\"+\\\" .. y\\nend\\nlocal recipes = {\\n  [\\\"wood+wood\\\"] = \\\"plank\\\",\\n  [\\\"plank+plank\\\"] = \\\"table\\\",\\n  [\\\"wood+stone\\\"] = \\\"axe\\\",\\n}\\nlogic_define('craft', function(a, b)\\n  return recipes[pair(a, b)] or 'none'\\nend)\\nreport('craft slot defined with 3 order-independent recipes')\"}","result":"{\"Success\":true,\"Output\":\"ok\"}","error":"","durationMs":2.4382}
{"scenarioId":"g4_shop","name":"execute_lua","status":"completed","arguments":"{\"code\":\"logic_define('item_price', function(item)\\n  local prices = { sword = 100, potion = 30, shield = 75 }\\n  return prices[item] or 0\\nend)\\n\\nlogic_define('can_buy', function(gold, price)\\n  return gold >= price\\nend)\\n\\nlogic_define('buy', function(gold, price)\\n  return gold - price\\nend)\\n\\nreport('Defined shop economy slots: item_price, can_buy, buy')\"}","result":"{\"Success\":true,\"Output\":\"ok\"}","error":"","durationMs":2.6572}
