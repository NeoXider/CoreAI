{"scenarioId":"g2_extreme_damage_pipeline","name":"execute_lua","status":"completed","arguments":"{\"code\":\"local floor=math.floor;local min=math.min;local max=math.max\\nlocal function elem_m(a,e)\\nif a=='physical'then if e=='ghost'then return 0 end return 100 end\\nif a=='fire'then if e=='fire'or e=='water'then return 50 elseif e=='nature'then return 200 end return 100 end\\nif a=='water'then if e=='fire'then return 200 elseif e=='water'or e=='nature'then return 50 end return 100 end\\nif a=='nature'then if e=='fire'then return 50 elseif e=='water'then return 200 elseif e=='nature'then return 50 end return 100 end\\nreturn 100\\nend\\nlocal function resolve_attack(attacker,defender,skill)\\nlocal atk=attacker.atk;local al=attacker.level\\nlocal cc=attacker.crit_chance or 0;local cm=attacker.crit_mult or 150\\nlocal pp=attacker.pen_pct or 0;local pf=attacker.pen_flat or 0\\nlocal hp=defender.hp;local sh=defender.shield or 0;local ar=defender.armor or 0\\nlocal dl=defender.level;local de=defender.element;local rs=defender.resist or {};local gd=defender.guarding or false\\nlocal pw=skill.power;local se=skill.element or 'physical';local nh=skill.hits or 1\\nlocal td=skill.true_damage or false;local sd=skill.seed or 0\\nlocal m=elem_m(se,de)\\nlocal dmg=0;local ab=0;local hits=0;local crits=0;local ok=0;local killed=false\\nfor k=1,nh do\\nlocal p=max(10,pw-20*(k-1))\\nlocal d=floor(atk*p/100)\\nlocal diff=min(max(al-dl,-10),10)\\nd=floor(d*(100+3*diff)/100)\\nlocal crit=((sd+17*k)%100)<cc\\nif crit then d=floor(d*cm/100);crits=crits+1 end\\nif not td then\\nlocal pen=pp\\nif crit then pen=pen*2 end\\nif pen>100 then pen=100 end\\nlocal ea=floor(ar*(100-pen)/100)-pf\\nif ea<0 then ea=0 end\\nd=floor(d*100/(100+ea))\\nd=floor(d*m/100)\\nlocal r=rs[se] or 0\\nif r<-50 then r=-50 elseif r>80 then r=80 end\\nd=floor(d*(100-r)/100)\\nend\\nif gd then d=floor(d/2) end\\nif d<1 then if (not td) and m==0 then d=0 else d=1 end end\\nlocal a=min(sh,d)\\nsh=sh-a\\nlocal loss=d-a\\nab=ab+a\\nif a>0 and sh==0 then loss=floor(loss*125/100) end\\nhits=hits+1\\nif loss>=hp then ok=loss-hp;dmg=dmg+hp;hp=0;killed=true;break\\nelse hp=hp-loss;dmg=dmg+loss end\\nend\\nreturn{damage=dmg,absorbed=ab,hp=hp,shield=sh,overkill=ok,crits=crits,hits=hits,killed=killed}\\nend\\nlocal function ser(t)\\nreturn string.format('damage=%s absorbed=%s hp=%s shield=%s overkill=%s crits=%s hits=%s killed=%s',tostring(t.damage),tostring(t.absorbed),tostring(t.hp),tostring(t.shield),tostring(t.overkill),tostring(t.crits),tostring(t.hits),tostring(t.killed))\\nend\\nlocal r1=resolve_attack({atk=40,level=12,crit_chance=30,crit_mult=150,pen_pct=25,pen_flat=5},{hp=60,shield=10,armor=40,level=10,element='nature',resist={fire=20},guarding=false},{power=120,element='fire',hits=2,true_damage=false,seed=3})\\nlocal r2=resolve_attack({atk=90,level=3,crit_chance=50,crit_mult=200,pen_pct=40,pen_flat=10},{hp=300,shield=25,armor=60,level=20,element='fire',resist={water=-30},guarding=true},{power=100,element='water',hits=3,true_damage=false,seed=40})\\nlogic_define('resolve_attack',resolve_attack)\\nreport('resolve_attack installed')\\nreturn 'E1: '..ser(r1)..' | E2: '..ser(r2)\"}","result":"{\"Success\":true,\"Output\":\"E1: damage=60 absorbed=10 hp=0 shield=0 overkill=57 crits=1 hits=1 killed=true | E2: damage=137 absorbed=25 hp=163 shield=0 overkill=0 crits=0 hits=3 killed=false\"}","error":"","durationMs":5.2637}
