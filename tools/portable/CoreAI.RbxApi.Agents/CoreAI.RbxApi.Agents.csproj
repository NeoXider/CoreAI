<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WHY this mirrors CoreAI.RbxApi.Agents.asmdef (noEngineReferences, references CoreAI.Core, Instances and
    Datatypes, no precompiled references): see ../CoreAI.RbxApi.Datatypes/CoreAI.RbxApi.Datatypes.csproj. The
    character pieces that connect NPCs and decision models to a Roblox-shaped Humanoid stay engine-free, so a
    UnityEngine reference in that folder has to break this build.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>CoreAI.RbxApi.Agents</AssemblyName>
    <RootNamespace>CoreAI.Mods.Rbx.Agents</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/CoreAIMods/Runtime/RbxApi/Agents/**/*.cs" />
    <ProjectReference Include="../CoreAI.Core.csproj" />
    <ProjectReference Include="../CoreAI.RbxApi.Datatypes/CoreAI.RbxApi.Datatypes.csproj" />
    <ProjectReference Include="../CoreAI.RbxApi.Instances/CoreAI.RbxApi.Instances.csproj" />
  </ItemGroup>
</Project>
