<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Portable run of the Lua-tier EditMode fixtures (Assets/CoreAIMods/Tests/EditMode) against the
    Lua-tier runtime compiled by ../LuaTier and the real Lua-CSharp plugin. See README.md for the
    design, the linked and excluded files, and the shim's fidelity limits.
    WHY CoreAI.Mods.Tests: it is the friend name CoreAI.Mods, CoreAI.Source, CoreAI.Core,
    CoreAI.RbxApi.Instances and CoreAI.RbxApi.Unity already grant InternalsVisibleTo, exactly as the
    Unity test asmdef of the same name gets them.
    WHY LangVersion 9 and nullable off: Unity compiles these test files as C# 9 with nullable off.
    WHY the list is explicit: a new fixture is linked only after it has been shown to compile and its
    engine dependencies have been judged; README.md records every excluded file and why.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CoreAI.Mods.Tests</AssemblyName>
    <RootNamespace>CoreAI.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);COREAI_LLM;COREAI_LUA</DefineConstants>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0414;CS0169;CS0649;CS0162;CS0168;CS0219;CS8632;CS0067;CS1998;CS4014</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RepoRoot>$(MSBuildThisFileDirectory)../../..</RepoRoot>
    <TestsRoot>$(RepoRoot)/Assets/CoreAIMods/Tests/EditMode</TestsRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CoreAI.Core.csproj" />
    <ProjectReference Include="../CoreAI.RbxApi.Datatypes/CoreAI.RbxApi.Datatypes.csproj" />
    <ProjectReference Include="../CoreAI.RbxApi.Instances/CoreAI.RbxApi.Instances.csproj" />
    <ProjectReference Include="../CoreAI.LuauDownlevel/CoreAI.LuauDownlevel.csproj" />
    <ProjectReference Include="../CoreAI.Mods.Folders/CoreAI.Mods.Folders.csproj" />
    <ProjectReference Include="../LuaTier/UnityEngine/UnityEngine.csproj" />
    <ProjectReference Include="../LuaTier/CoreAI.Source/CoreAI.Source.csproj" />
    <ProjectReference Include="../LuaTier/CoreAI.RbxApi.Unity/CoreAI.RbxApi.Unity.csproj" />
    <ProjectReference Include="../LuaTier/CoreAI.RbxApi.Binding/CoreAI.RbxApi.Binding.csproj" />
    <ProjectReference Include="../LuaTier/CoreAI.Mods/CoreAI.Mods.csproj" />
    <Reference Include="Lua">
      <HintPath>$(RepoRoot)/Assets/CoreAIMods/Plugins/Lua.dll</HintPath>
    </Reference>
    <PackageReference Include="UniTask" Version="2.5.11" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <!--
    WHY one helper is compiled from a derived copy: Mvp1AcceptanceHarness.cs holds the
    GameObject-backed Mvp1AcceptanceWorld next to two engine-free helpers (Mvp1AcceptanceMemoryStore,
    Mvp1AcceptanceNullLogger) that the world-package and physics-port acceptance fixtures use on their
    own. The copy blanks Mvp1AcceptanceWorld only (see ../LuaTier/PortableDerivedSources.targets); a
    fixture that needs the world itself does not compile and stays excluded. No test is ever sliced.
  -->
  <ItemGroup>
    <PortableSlice Include="$(TestsRoot)/RbxApi/Acceptance/Mvp1AcceptanceHarness.cs"
                   BlankType="internal sealed class Mvp1AcceptanceWorld"
                   OutputName="Mvp1AcceptanceHarness.cs"
                   Link="Assets/CoreAIMods/Tests/EditMode/RbxApi/Acceptance/Mvp1AcceptanceHarness.cs" />
  </ItemGroup>
  <Import Project="../LuaTier/PortableDerivedSources.targets" />
