<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      WHY LangVersion 9.0: Unity compiles every linked test file as C# 9; a newer language feature in one
      of them must break this build as it breaks the editor's, not pass here and fail there.
    -->
    <LangVersion>9.0</LangVersion>
    <!--
      WHY CoreAI.Mods.Tests: it is the one name both linked runtimes already trust. CoreAI.Core and
      CoreAI.RbxApi.Instances each grant it InternalsVisibleTo, and the scheduler, registry and
      replication fixtures reach internal seams (SpawnSignal, BindScheduler, SetReplicatedRevision).
      Borrowing an existing friend name keeps the runtime friend lists exactly as Unity ships them.
    -->
    <AssemblyName>CoreAI.Mods.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);COREAI_LLM</DefineConstants>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
