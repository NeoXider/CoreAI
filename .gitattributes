# Auto-detect text files; explicit Unity/source rules below prevent
# editor-dependent CRLF/LF churn and binary asset phantom diffs.
* text=auto
.gitattributes text eol=lf

# Source and docs.
*.cs text eol=lf diff=csharp
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf

# Visual Studio / Unity generated project files are Windows-native.
*.sln text eol=crlf
*.csproj text eol=crlf

# Unity YAML assets.
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable text eol=lf
*.mask text eol=lf
*.renderTexture text eol=lf
*.terrainlayer text eol=lf
*.lighting text eol=lf
*.guiskin text eol=lf
*.preset text eol=lf

